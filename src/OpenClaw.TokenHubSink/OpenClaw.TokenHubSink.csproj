<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OpenClaw.TokenHubSink</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Self-contained, in-sandbox HTTP thin client for the TokenHub pipeline (see
    docs: TokenHub-Token用量旁路采集与Kafka-Doris汇聚-设计文档). Mirrors the TokenHub.Core
    contract + TokenHub.GatewaySink sink so kingcrab can ship token usage events to the
    out-of-sandbox TokenHub.Collector with zero cross-repo dependency. Holds no Kafka
    client and no broker credentials; Publish only enqueues into a bounded in-memory channel.

    The JSON wire contract (snake_case [JsonPropertyName] on SessionTokenUsageEvent) MUST stay
    byte-identical to TokenHub.Core so the collector / Doris jsonpaths keep matching.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>
</Project>
