<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OpenClawEnableOpenSandbox Condition="'$(OpenClawEnableOpenSandbox)' == ''">false</OpenClawEnableOpenSandbox>
    <RootNamespace>OpenClaw.Tests</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.Core\OpenClaw.Core.csproj" />
    <ProjectReference Include="..\OpenClaw.Agent\OpenClaw.Agent.csproj" />
    <ProjectReference Include="..\OpenClaw.Channels\OpenClaw.Channels.csproj" />
    <ProjectReference Include="..\OpenClaw.Cli\OpenClaw.Cli.csproj" />
    <ProjectReference Include="..\OpenClaw.Companion\OpenClaw.Companion.csproj" />
    <ProjectReference Include="..\OpenClaw.Gateway\OpenClaw.Gateway.csproj" />
    <ProjectReference Include="..\OpenClaw.PluginKit\OpenClaw.PluginKit.csproj" />
    <ProjectReference Include="..\OpenClaw.Plugins.EmploymentCoachWorkflow\OpenClaw.Plugins.EmploymentCoachWorkflow.csproj" />
    <ProjectReference Include="..\OpenClaw.Plugins.Mempalace\OpenClaw.Plugins.Mempalace.csproj" />
    <ProjectReference Include="..\OpenClaw.TestPluginFixtures\OpenClaw.TestPluginFixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- Files that require optional assemblies not present in the default build -->
  <ItemGroup>
    <Compile Remove="WhatsAppWorkerServiceTests.cs" />
    <!-- Avalonia.Headless.XUnit PackageReference 上游缺失 -->
    <Compile Remove="CompanionCanvasUiTests.cs" />
    <!-- CronScheduler API 漂移：IsTimeForJob 实例方法已重构为 IsTime 静态方法；核心场景由 ResilienceTests.CronScheduler_IsTime_* 覆盖 -->
    <Compile Remove="CronSchedulerTests.cs" />
    <!-- FractalMemoryTests 依赖已永久排除的 native AgentRuntime（SOP 永久原则） -->
    <Compile Remove="FractalMemoryTests.cs" />
    <!-- AgentRuntimeTests 同上：依赖 native AgentRuntime 类（SOP 永久原则） -->
    <Compile Remove="AgentRuntimeTests.cs" />
    <!-- BeyondBaseTests / FeatureParityTests / MemoryRecallInjectionTests 均直接 new AgentRuntime(...)，同 native runtime 永久排除 -->
    <Compile Remove="BeyondBaseTests.cs" />
    <Compile Remove="FeatureParityTests.cs" />
    <Compile Remove="MemoryRecallInjectionTests.cs" />
  </ItemGroup>

  <!-- Suppress xUnit analyzer rule that treats CancellationToken usage as errors -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
