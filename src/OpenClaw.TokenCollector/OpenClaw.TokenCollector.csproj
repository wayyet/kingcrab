<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>OpenClaw.TokenCollector</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- Plain JIT runtime (no AOT/trim): Confluent.Kafka ships native librdkafka. -->
    <PublishAot>false</PublishAot>
    <UserSecretsId>openclaw-token-collector</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.Core\OpenClaw.Core.csproj" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
