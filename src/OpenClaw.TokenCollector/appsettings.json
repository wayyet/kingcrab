{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Collector": {
    "BindUrl": "http://0.0.0.0:8088",
    "AuthTokenRef": "env:TOKEN_COLLECTOR_TOKEN",
    "MaxRequestBytes": 1048576,
    "Kafka": {
      "Enabled": true,
      "BootstrapServers": "localhost:9092",
      "Topic": "session-token-metrics",
      "ClientId": "openclaw-token-usage",
      "QueueCapacity": 4096,
      "LingerMs": 100,
      "SecurityProtocol": "plaintext",
      "SaslUsernameRef": null,
      "SaslPasswordRef": null
    }
  }
}
