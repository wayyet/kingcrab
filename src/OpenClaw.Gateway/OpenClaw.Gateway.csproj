<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>OpenClaw.Gateway</RootNamespace>
    <OutputType>Exe</OutputType>
    <OpenClawEnableOpenSandbox Condition="'$(OpenClawEnableOpenSandbox)' == ''">false</OpenClawEnableOpenSandbox>
    <PublishAot>false</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Aggressive AOT trimming for minimal binary -->
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>true</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <!-- Playwright is not AOT-compatible (deep reflection usage); keep package-level warnings suppressed while surfacing project-owned trim diagnostics. -->
    <NoWarn>$(NoWarn);IL2104;IL3000;IL3002;IL3053</NoWarn>
    <UserSecretsId>c2b614a1-b67f-4679-b72f-f37c5e759f4d</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Kingcrab.ServiceDefaults\Kingcrab.ServiceDefaults.csproj" />
    <ProjectReference Include="..\OpenClaw.Core\OpenClaw.Core.csproj" />
    <ProjectReference Include="..\OpenClaw.Agent\OpenClaw.Agent.csproj" />
    <ProjectReference Include="..\OpenClaw.Channels\OpenClaw.Channels.csproj" />
    <ProjectReference Include="..\OpenClaw.Payments.Abstractions\OpenClaw.Payments.Abstractions.csproj" />
    <ProjectReference Include="..\OpenClaw.Payments.Core\OpenClaw.Payments.Core.csproj" />
    <ProjectReference Include="..\OpenClaw.Payments.StripeLink\OpenClaw.Payments.StripeLink.csproj" />
    <ProjectReference Include="..\OpenClaw.Plugins.Payment\OpenClaw.Plugins.Payment.csproj" />
  </ItemGroup>
  <!-- Dashboard Blazor WASM is integrated via CopyDashboardFiles targets below.
       Keep it out of ProjectReference to avoid Static Web Assets cross-project
       resolution conflicts in Gateway builds. -->
  <ItemGroup>
    <PackageReference Include="A2A" Version="1.0.0-preview2" />
    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.8.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A" Version="1.8.0-preview.260528.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.8.0-preview.260528.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(OpenClawEnableOpenSandbox)' == 'true'">
    <ProjectReference Include="..\OpenClawNet.Sandbox.OpenSandbox\OpenClawNet.Sandbox.OpenSandbox.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OpenClawEnableMafExperiment)' == 'true'">
    <DefineConstants>$(DefineConstants);OPENCLAW_ENABLE_MAF_EXPERIMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.19.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="GeminiDotnet.Extensions.AI" Version="0.25.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />		
	<PackageReference Include="Microsoft.Agents.AI.DevUI" Version="1.8.0-preview.260528.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.8.0-preview.260528.1" />
	<PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.8.0-alpha.260528.1" />    
	<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OpenClawEnableOpenSandbox)' == 'true'">
    <DefineConstants>$(DefineConstants);OPENCLAW_ENABLE_OPENSANDBOX</DefineConstants>
  </PropertyGroup>
	<ItemGroup>
		<Content Update="skills\**\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="skills\**\*" Exclude="skills\**\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Update="wwwroot\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenClaw.Tests" />
  </ItemGroup>

  <!-- Publish Dashboard WASM so all assets (_framework/, _content/, css/) are materialized on disk.
       Runs AfterTargets=Build so the ProjectReference build of Dashboard completes first. -->
  <Target Name="CopyDashboardFiles" AfterTargets="Build">
    <PropertyGroup>
      <_DashboardProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'OpenClaw.Dashboard', 'OpenClaw.Dashboard.csproj'))</_DashboardProject>
      <_DashboardPublishDir>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'OpenClaw.Dashboard', 'bin', 'publish'))</_DashboardPublishDir>
      <_DashboardPublishWwwroot>$(_DashboardPublishDir)\wwwroot</_DashboardPublishWwwroot>
    </PropertyGroup>
    <RemoveDir Directories="$(_DashboardPublishDir);$(OutputPath)wwwroot\dashboard" />
    <Exec Command="dotnet publish &quot;$(_DashboardProject)&quot; -c $(Configuration) -o &quot;$(_DashboardPublishDir)&quot; --nologo -v q" />
    <ItemGroup>
      <_DashboardPublishFiles Include="$(_DashboardPublishWwwroot)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DashboardPublishFiles)" DestinationFolder="$(OutputPath)wwwroot\dashboard\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_DashboardPublishFiles)' != ''" />
    <!-- Create a non-fingerprinted copy of the Blazor boot script so that the
         <script src="_framework/blazor.webassembly.js"> reference in index.html
         resolves to an actual file when served by UseStaticFiles in production. -->
    <ItemGroup>
      <_BlazorBootScript Include="$(OutputPath)wwwroot\dashboard\_framework\blazor.webassembly.*.js" Exclude="$(OutputPath)wwwroot\dashboard\_framework\blazor.webassembly.*.js.gz;$(OutputPath)wwwroot\dashboard\_framework\blazor.webassembly.*.js.br;$(OutputPath)wwwroot\dashboard\_framework\blazor.webassembly.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_BlazorBootScript)" DestinationFiles="$(OutputPath)wwwroot\dashboard\_framework\blazor.webassembly.js" SkipUnchangedFiles="true" Condition="'@(_BlazorBootScript)' != ''" />
    <ItemGroup>
      <_DotNetBootScript Include="$(OutputPath)wwwroot\dashboard\_framework\dotnet.*.js" Exclude="$(OutputPath)wwwroot\dashboard\_framework\dotnet.runtime.*.js;$(OutputPath)wwwroot\dashboard\_framework\dotnet.native.*.js;$(OutputPath)wwwroot\dashboard\_framework\dotnet.*.js.gz;$(OutputPath)wwwroot\dashboard\_framework\dotnet.*.js.br;$(OutputPath)wwwroot\dashboard\_framework\dotnet.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_DotNetBootScript)" DestinationFiles="$(OutputPath)wwwroot\dashboard\_framework\dotnet.js" SkipUnchangedFiles="true" Condition="'@(_DotNetBootScript)' != ''" />
  </Target>

  <!-- Copy Dashboard publish output to Gateway publish dir -->
  <Target Name="CopyDashboardFilesPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_DashboardProjectPub>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'OpenClaw.Dashboard', 'OpenClaw.Dashboard.csproj'))</_DashboardProjectPub>
      <_DashboardPublishDirPub>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'OpenClaw.Dashboard', 'bin', 'publish'))</_DashboardPublishDirPub>
      <_DashboardPublishWwwrootPub>$(_DashboardPublishDirPub)\wwwroot</_DashboardPublishWwwrootPub>
    </PropertyGroup>
    <RemoveDir Directories="$(_DashboardPublishDirPub);$(PublishDir)wwwroot\dashboard" />
    <Exec Command="dotnet publish &quot;$(_DashboardProjectPub)&quot; -c $(Configuration) -o &quot;$(_DashboardPublishDirPub)&quot; --nologo -v q" />
    <ItemGroup>
      <_DashboardPublishPubFiles Include="$(_DashboardPublishWwwrootPub)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DashboardPublishPubFiles)" DestinationFolder="$(PublishDir)wwwroot\dashboard\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_DashboardPublishPubFiles)' != ''" />
    <!-- Create non-fingerprinted boot script copy for production -->
    <ItemGroup>
      <_BlazorBootScriptPub Include="$(PublishDir)wwwroot\dashboard\_framework\blazor.webassembly.*.js" Exclude="$(PublishDir)wwwroot\dashboard\_framework\blazor.webassembly.*.js.gz;$(PublishDir)wwwroot\dashboard\_framework\blazor.webassembly.*.js.br;$(PublishDir)wwwroot\dashboard\_framework\blazor.webassembly.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_BlazorBootScriptPub)" DestinationFiles="$(PublishDir)wwwroot\dashboard\_framework\blazor.webassembly.js" SkipUnchangedFiles="true" Condition="'@(_BlazorBootScriptPub)' != ''" />
    <ItemGroup>
      <_DotNetBootScriptPub Include="$(PublishDir)wwwroot\dashboard\_framework\dotnet.*.js" Exclude="$(PublishDir)wwwroot\dashboard\_framework\dotnet.runtime.*.js;$(PublishDir)wwwroot\dashboard\_framework\dotnet.native.*.js;$(PublishDir)wwwroot\dashboard\_framework\dotnet.*.js.gz;$(PublishDir)wwwroot\dashboard\_framework\dotnet.*.js.br;$(PublishDir)wwwroot\dashboard\_framework\dotnet.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_DotNetBootScriptPub)" DestinationFiles="$(PublishDir)wwwroot\dashboard\_framework\dotnet.js" SkipUnchangedFiles="true" Condition="'@(_DotNetBootScriptPub)' != ''" />
  </Target>
</Project>
