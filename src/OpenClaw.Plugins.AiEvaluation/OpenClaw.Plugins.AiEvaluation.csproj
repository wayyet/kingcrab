<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenClaw.Plugins.AiEvaluation</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>OpenClaw.Plugins.AiEvaluation</PackageId>
    <Description>AI evaluation plugin providing skills and cross-platform scripts for sandbox evaluation workflows.</Description>
    <PackageTags>openclaw;plugins;ai-evaluation;skills;scripts;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.PluginKit\OpenClaw.PluginKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="openclaw.native-plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="skills\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="scripts\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
