{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kingcrab.local/schemas/metric.schema.json",
  "title": "EvaluationMetricFile",
  "description": "Schema for a single hot-loadable evaluation metric file under ./metrics/<metric_code>.metric.json",
  "type": "object",
  "required": [
    "metric_code",
    "version",
    "display_name",
    "parent_dimension",
    "applicable_roles",
    "applicable_scenarios",
    "scoring_rubric",
    "runtime_slice_selector",
    "aggregation_strategy"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metric_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable machine identifier; must match the file basename (excluding .metric.json)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parent_dimension": {
      "type": "string",
      "enum": [
        "functional_completeness",
        "interaction_quality",
        "process_compliance",
        "problem_resolution",
        "tool_call_correctness"
      ],
      "description": "Roll-up target. The 5 fixed parent dimensions are preserved for red-line and overall scoring compatibility."
    },
    "applicable_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Roles this metric applies to. Use '*' to mean role-agnostic."
    },
    "applicable_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Scenario tags this metric applies to. Use '*' to match any scenario."
    },
    "evidence_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hints about what runtime data segments contain evidence for this metric."
    },
    "runtime_slice_selector": {
      "type": "object",
      "required": ["include"],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Whitelist of runtime data paths to include in the per-metric prompt slice."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Blacklist applied after include."
        }
      }
    },
    "scoring_rubric": {
      "type": "object",
      "required": ["excellent_80_100", "acceptable_60_79", "poor_below_60"],
      "additionalProperties": false,
      "properties": {
        "excellent_80_100": { "type": "string" },
        "acceptable_60_79": { "type": "string" },
        "poor_below_60": { "type": "string" }
      }
    },
    "aggregation_strategy": {
      "type": "string",
      "enum": [
        "weighted_average_by_difficulty",
        "simple_average",
        "worst_case",
        "pass_rate",
        "coverage"
      ],
      "description": "How per-scenario scores collapse into a single per-metric score."
    },
    "default_weight_within_dimension": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "red_line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": { "type": "number" },
        "comparator": {
          "type": "string",
          "enum": ["<=", "<", ">=", ">", "=="]
        },
        "trigger_kind": {
          "type": "string",
          "enum": ["dimension_floor", "missing_required_signal", "forbidden_behavior"]
        },
        "notes": { "type": "string" }
      },
      "description": "Optional. If a metric carries a red-line trigger, declare it here so the deterministic redLineCheck step can find it."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
