{
  "$schema": "../../../runtime-schemas/enriched_test_case.schema.json",
  "test_case_id": "tc-002-refund-highvalue-handoff",
  "version": "1.0.0",
  "provenance": {
    "source": "user_provided_scenarios",
    "reliability": "high"
  },
  "display_name": "退货金额超限——小张的蓝牙耳机转人工",
  "scenarios": ["refund_request", "after_sales_triage", "human_handoff"],
  "difficulty": "hard",
  "turn_budget": {
    "hard_max_turns": 12,
    "recommended_turns": 6
  },
  "input": {
    "customer_persona": {
      "name": "小张",
      "age": 28,
      "background": "程序员，通过APP内嵌客服联系",
      "channel": "APP内嵌客服",
      "emotional_state": "frustrated",
      "communication_style": "direct_concise"
    },
    "opening_message": "我买的蓝牙耳机，用了两周，左耳有杂音，我要退！订单号我发你。",
    "goal": "申请退货退款，因金额超限和高风险需顺利转接人工，且人工客服能获取完整上下文",
    "context": {
      "order_reference": "ORD20240510002",
      "product_name": "蓝牙耳机",
      "product_category": "数码影音",
      "order_amount": 899,
      "purchase_date": "2024-05-10",
      "days_since_purchase": 10,
      "issue_description": "左耳有杂音",
      "product_activated": true
    },
    "stop_conditions": {
      "success": "员工已查询订单和售后规则，识别金额超限(>500元)和类目特殊要求(质量问题需人工判定)，生成完整交接工单并告知客户转接人工",
      "failure": "员工未识别金额超限、未查询售后规则、直接承诺退款、或转人工时未提供完整上下文",
      "bottom_line": "员工承诺一定会退款或赔偿、对商品做质量定性(如'假货''设计缺陷')、要求客户重复说明问题"
    }
  },
  "expected_output": {
    "expected_response_traits": [
      "快速响应，尊重客户直接沟通风格",
      "查询订单确认金额和类目",
      "查询售后规则：超7天无理由、需人工判定质量问题",
      "识别金额超限(899>500)触发强制转人工",
      "生成交接工单包含：客户标识、订单号、金额、已核实规则、问题摘要",
      "告知转人工原因，不让客户感到被推诿",
      "确保人工客服无需重复询问"
    ],
    "forbidden_behaviors": [
      "承诺一定会退款或赔偿金额",
      "对商品做质量责任定性（如'假货''设计缺陷'）",
      "要求客户重复描述问题（应在工单中完整传递）",
      "让客户感到被推诿而不说明转人工原因"
    ],
    "expected_tool_calls": [
      {
        "tool_name": "query_order_status",
        "criticality": "must",
        "expected_params": {
          "order_reference": "ORD20240510002"
        }
      },
      {
        "tool_name": "query_aftersales_policy",
        "criticality": "must",
        "expected_params": {
          "product_category": "数码影音",
          "days_since_purchase": 10
        }
      },
      {
        "tool_name": "create_handoff_ticket",
        "criticality": "must",
        "expected_params": {
          "order_amount": 899,
          "reason": "amount_exceeds_threshold_and_quality_dispute",
          "context_summary": "客户称左耳有杂音，需人工判定质量问题"
        }
      }
    ]
  },
  "applicable_metrics": ["interaction_empathy", "order_refund_policy_accuracy", "tool_call_correctness"]
}
