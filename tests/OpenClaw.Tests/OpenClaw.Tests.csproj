<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OpenClawEnableOpenSandbox Condition="'$(OpenClawEnableOpenSandbox)' == ''">false</OpenClawEnableOpenSandbox>
    <RootNamespace>OpenClaw.Tests</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClaw.Client\OpenClaw.Client.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Core\OpenClaw.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Agent\OpenClaw.Agent.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Channels\OpenClaw.Channels.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Cli\OpenClaw.Cli.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.Gateway\OpenClaw.Gateway.csproj" />
    <ProjectReference Include="..\..\src\OpenClaw.PluginKit\OpenClaw.PluginKit.csproj" />
    <ProjectReference Include="..\..\src\OpenClawNet.Sandbox.OpenSandbox\OpenClawNet.Sandbox.OpenSandbox.csproj" />
    <ProjectReference Include="..\OpenClaw.TestPluginFixtures\OpenClaw.TestPluginFixtures.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OpenClawEnableMafExperiment)' == 'true'">
    <ProjectReference Include="..\OpenClaw.MicrosoftAgentFrameworkAdapter\OpenClaw.MicrosoftAgentFrameworkAdapter.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OpenClawEnableMafExperiment)' == 'true'">
    <OpenClawEnableOpenSandbox Condition="'$(OpenClawEnableOpenSandbox)' == ''">false</OpenClawEnableOpenSandbox>
    <RootNamespace>OpenClaw.Tests</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.5" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
